    <script>
        // --- 1. DỮ LIỆU ĐỘNG LỰC ---
        const quotes = [
            "Hôm nay bạn đã học giỏi hơn ngày hôm qua một chút rồi đấy! 🌸",
            "Đừng nản lòng, những nỗ lực thầm lặng hôm nay sẽ nở hoa rực rỡ ngày mai. ✨",
            "Giấc mơ đại học không xa, chỉ cần bạn bước thêm một bước nữa! 💖",
            "Mỗi bài tập giải được là một bậc thang đưa bạn đến cánh cửa đại học mơ ước. 📚",
            "Thanh xuân có hạn, hãy cháy hết mình vì tương lai chính mình nhé! 🌷",
            "Đừng đếm ngày qua đi, hãy làm cho ngày hôm nay có giá trị! ⭐"
        ];

        function changeQuote() {
            const randomIndex = Math.floor(Math.random() * quotes.length);
            document.getElementById('motivationQuote').innerText = `"${quotes[randomIndex]}"`;
        }

        // --- 2. QUẢN LÝ ĐẾM NGƯỢC & LOCALSTORAGE ---
        let examsData = JSON.parse(localStorage.getItem('examsData')) || {
            thptqg: { name: "THPT Quốc Gia", date: "2027-06-11T07:30:00" },
            tsa: { name: "TSA (Bách Khoa)", date: "2027-03-20T08:00:00" },
            hsa: { name: "HSA (ĐHQG HN)", date: "2027-03-13T08:00:00" }
        };

        let currentEditingExam = null;

        function initExamsUI() {
            for (let key in examsData) {
                document.getElementById(`name-${key}`).innerText = examsData[key].name;
                const d = new Date(examsData[key].date);
                const dateStr = `${d.getDate().toString().padStart(2, '0')}/${(d.getMonth()+1).toString().padStart(2, '0')}/${d.getFullYear()} ${d.getHours().toString().padStart(2, '0')}:${d.getMinutes().toString().padStart(2, '0')}`;
                document.getElementById(`date-sub-${key}`).innerText = `Thi: ${dateStr}`;
            }
        }

        function updateCountdowns() {
            const now = new Date().getTime();
            for (let key in examsData) {
                const examTime = new Date(examsData[key].date).getTime();
                const distance = examTime - now;

                if (distance < 0) {
                    document.getElementById(`days-${key}`).innerText = "00";
                    document.getElementById(`hours-${key}`).innerText = "00";
                    document.getElementById(`mins-${key}`).innerText = "00";
                    document.getElementById(`secs-${key}`).innerText = "00";
                } else {
                    const days = Math.floor(distance / (1000 * 60 * 60 * 24));
                    const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                    const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                    const seconds = Math.floor((distance % (1000 * 60)) / 1000);

                    document.getElementById(`days-${key}`).innerText = days.toString().padStart(2, '0');
                    document.getElementById(`hours-${key}`).innerText = hours.toString().padStart(2, '0');
                    document.getElementById(`mins-${key}`).innerText = minutes.toString().padStart(2, '0');
                    document.getElementById(`secs-${key}`).innerText = seconds.toString().padStart(2, '0');
                }
            }
        }
        setInterval(updateCountdowns, 1000);
        updateCountdowns();
        initExamsUI();

        // Modal Chỉnh sửa
        function openEditModal(key) {
            currentEditingExam = key;
            document.getElementById('editExamName').value = examsData[key].name;
            document.getElementById('editExamDateTime').value = examsData[key].date;
            document.getElementById('editModal').classList.add('active');
        }

        function closeEditModal() {
            document.getElementById('editModal').classList.remove('active');
        }

        function saveExamChanges() {
            if (!currentEditingExam) return;
            const newName = document.getElementById('editExamName').value;
            const newDate = document.getElementById('editExamDateTime').value;
            if (newName && newDate) {
                examsData[currentEditingExam].name = newName;
                examsData[currentEditingExam].date = newDate;
                localStorage.setItem('examsData', JSON.stringify(examsData));
                initExamsUI();
                updateCountdowns();
                closeEditModal();
            }
        }

        // --- 3. TO-DO LIST ---
        let todos = JSON.parse(localStorage.getItem('studyTodos')) || [
            { text: "Ôn tập Toán hàm số", completed: true },
            { text: "Làm đề thi thử Tiếng Anh", completed: false },
            { text: "Học từ vựng tiếng Anh mỗi ngày", completed: false }
        ];

        function saveTodos() {
            localStorage.setItem('studyTodos', JSON.stringify(todos));
            renderTodos();
        }

        function renderTodos() {
            const listEl = document.getElementById('todoList');
            listEl.innerHTML = '';
            if (todos.length === 0) {
                listEl.innerHTML = '<li style="text-align:center; color: var(--text-light); padding: 15px; font-size: 0.85rem;">Chưa có nhiệm vụ nào, hãy thêm mới nhé! 🌸</li>';
                updateProgress(0);
                return;
            }

            let completedCount = 0;
            todos.forEach((todo, index) => {
                if (todo.completed) completedCount++;
                const li = document.createElement('li');
                li.className = `todo-item ${todo.completed ? 'completed' : ''}`;
                li.innerHTML = `
                    <div class="todo-item-left" onclick="toggleTodo(${index})">
                        <input type="checkbox" ${todo.completed ? 'checked' : ''}>
                        <span>${todo.text}</span>
                    </div>
                    <button class="todo-delete" onclick="deleteTodo(${index})"><i class="fa-solid fa-trash-can"></i></button>
                `;
                listEl.appendChild(li);
            });

            const percent = Math.round((completedCount / todos.length) * 100);
            updateProgress(percent);
        }

        function updateProgress(percent) {
            document.getElementById('progressBar').style.width = `${percent}%`;
            document.getElementById('progressText').innerText = `Đã hoàn thành: ${percent}%`;
        }

        function addTodo() {
            const input = document.getElementById('todoInput');
            const text = input.value.trim();
            if (text) {
                todos.push({ text: text, completed: false });
                input.value = '';
                saveTodos();
            }
        }

        function handleTodoKey(e) {
            if (e.key === 'Enter') addTodo();
        }

        function toggleTodo(index) {
            todos[index].completed = !todos[index].completed;
            saveTodos();
        }

        function deleteTodo(index) {
            todos.splice(index, 1);
            saveTodos();
        }

        renderTodos();

        // --- 4. MINI CALENDAR ---
        function renderCalendar() {
            const now = new Date();
            const year = now.getFullYear();
            const month = now.getMonth();
            const todayDate = now.getDate();

            const monthNames = ["Tháng 1", "Tháng 2", "Tháng 3", "Tháng 4", "Tháng 5", "Tháng 6", "Tháng 7", "Tháng 8", "Tháng 9", "Tháng 10", "Tháng 11", "Tháng 12"];
            document.getElementById('calendarMonthYear').innerText = `${monthNames[month]}, ${year}`;

            const grid = document.getElementById('calendarGrid');
            grid.innerHTML = '';

            const dayNames = ['T2', 'T3', 'T4', 'T5', 'T6', 'T7', 'CN'];
            dayNames.forEach(d => {
                const div = document.createElement('div');
                div.className = 'calendar-day-name';
                div.innerText = d;
                grid.appendChild(div);
            });

            const firstDayIndex = (new Date(year, month, 1).getDay() + 6) % 7;
            const totalDays = new Date(year, month + 1, 0).getDate();

            for (let i = 0; i < firstDayIndex; i++) {
                const div = document.createElement('div');
                grid.appendChild(div);
            }

            for (let i = 1; i <= totalDays; i++) {
                const div = document.createElement('div');
                div.className = `calendar-cell ${i === todayDate ? 'today' : ''}`;
                div.innerText = i;
                grid.appendChild(div);
            }
        }
        renderCalendar();

        // --- 5. STICKY NOTE ---
        const stickyNoteEl = document.getElementById('stickyNote');
        stickyNoteEl.value = localStorage.getItem('studyStickyNote') || "💡 Mục tiêu tuần này:\n- Hoàn thành 3 đề toán.\n- Học thuộc 50 từ vựng.\n- Giữ tinh thần luôn vui vẻ! 🌸";

        function saveStickyNote() {
            localStorage.setItem('studyStickyNote', stickyNoteEl.value);
        }
    </script>
</body>
</html>

